{
    "id": "org.freedesktop.LinuxAudio.Plugins.jc303",
    "runtime": "org.freedesktop.LinuxAudio.BaseExtension",
    "runtime-version": "stable",
    "sdk": "org.freedesktop.Sdk//25.08",
    "build-extension": true,
    "branch": "25.08",
    "build-options": {
        "prefix": "/app/extensions/Plugins/jc303"
    },
    "modules": [
        {
            "name": "jc303",
            "buildsystem": "cmake-ninja",
            "config-opts": [
                "-DCMAKE_AR=/usr/bin/gcc-ar",
                "-DCMAKE_NM=/usr/bin/gcc-nm",
                "-DCMAKE_RANLIB=/usr/bin/gcc-ranlib",
                "-DFETCHCONTENT_FULLY_DISCONNECTED=ON"
            ],
            "build-options": {
                "env": {
                    "CPM_SOURCE_CACHE": "/run/build/jc303/.cache/CPM"
                }
            },
            "cleanup": [
                "/bin",
                "/include",
                "/lib/cmake"
            ],
            "post-install": [
                "install -d $FLATPAK_DEST/lv2",
                "install -d $FLATPAK_DEST/vst3",
                "cp -r JC303_artefacts/Release/LV2/JC303.lv2 $FLATPAK_DEST/lv2",
                "strip $FLATPAK_DEST/lv2/JC303.lv2/libJC303.so",
                "cp -r JC303_artefacts/Release/VST3/JC303.vst3 $FLATPAK_DEST/vst3",
                "strip $FLATPAK_DEST/vst3/JC303.vst3/Contents/*/JC303.so",
                "install -D JC303_artefacts/Release/CLAP/JC303.clap -t $FLATPAK_DEST/clap",
                "strip $FLATPAK_DEST/clap/JC303.clap",
                "install -Dm644 org.freedesktop.LinuxAudio.Plugins.jc303.metainfo.xml -t $FLATPAK_DEST/share/metainfo"
            ],
            "sources": [
                {
                    "type": "git",
                    "url": "https://github.com/midilab/jc303.git",
                    "tag": "v0.12.1",
                    "commit": "2be813a8647cbd91178152b30da268cb61490705"
                },
                {
                    "type": "git",
                    "url": "https://github.com/juce-framework/JUCE.git",
                    "tag": "7.0.5",
                    "commit": "69795dc8e589a9eb5df251b6dd994859bf7b3fab",
                    "dest": "lib/JUCE"
                },
                {
                    "type": "git",
                    "url": "https://github.com/free-audio/clap-juce-extensions.git",
                    "commit": "a3227c52fa082d2df33f4377ed1e050dd8a52595",
                    "dest": "lib/juce-clap-extensions-src"
                },
                {
                    "type": "git",
                    "url": "https://github.com/Chowdhury-DSP/chowdsp_utils.git",
                    "commit": "ffc70ba399f9afaeefb996eb14e55a1d487270b8",
                    "dest": "lib/chowdsp_utils-src"
                },
                {
                    "type": "git",
                    "url": "https://github.com/jatinchowdhury18/RTNeural.git",
                    "commit": "04cb333bc4b174760958a77c7ce076eae38fe8e4",
                    "dest": "lib/rtneural-src"
                },
                {
                    "type": "file",
                    "url": "https://github.com/cpm-cmake/CPM.cmake/releases/download/v0.38.6/CPM.cmake",
                    "sha256": "11c3fa5f1ba14f15d31c2fb63dbc8628ee133d81c8d764caad9a8db9e0bacb07",
                    "dest": ".cache/CPM/cpm",
                    "dest-filename": "CPM_0.38.6.cmake"
                },
                {
                    "type": "git",
                    "url": "https://github.com/Chowdhury-DSP/math_approx.git",
                    "commit": "0c68d4d17242d707ba07fa7f1901692b7ed72d58",
                    "dest": "lib/math_approx-src"
                },
                {
                    "type": "git",
                    "url": "https://github.com/eyalamirmusic/Variant.git",
                    "commit": "3fce49cfca50ba3b05026d41ffc4911a8e653378",
                    "dest": "lib/ea_variant-src"
                },
                {
                    "type": "file",
                    "path": "org.freedesktop.LinuxAudio.Plugins.jc303.metainfo.xml"
                }
            ]
        }
    ]
}
